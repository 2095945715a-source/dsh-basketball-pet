{
  "name": "dsh-basketball-pet",
  "version": "1.3.1",
  "type": "module",
  "description": "A basketball desktop pet for the DSH Web UI: drag the hoop and the ball crate anywhere, flick the ball in, bouncy physics, swish feedback and a score that resets every day.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "desktop-pet",
    "basketball",
    "mini-game",
    "toy"
  ],
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "preview.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-slots"]
    }
  }
}
